# ==============================================================================
# TRUSTGATE REAL DATA CONFIGURATION (.env.example)
# ==============================================================================

# 1. API Provider Payout Account (Concordium Testnet)
# Where fees paid by agents will be deposited
API_PROVIDER_PAYOUT_ADDRESS=4c9f116719b6736c92bc490453d0e34c264c8a21
PAYMENT_PRICE_PER_CALL=0.002
PAYMENT_CURRENCY=CCD

# 2. Concordium Agent Registry (CIS-8004) & Badge Verification
# Live Hosted Verifier or local Docker MCP (concordium/agent-registry-mcp)
CONCORDIUM_BADGE_VERIFIER_URL=https://agent-registry.concordium.com/api/verify-badge
CONCORDIUM_NETWORK=testnet
CONCORDIUM_NODE_URL=https://grpc.testnet.concordium.com:20000

# 3. Agent A Real Identity & Key Credentials
# Put your real registered agent badge and account here:
REAL_AGENT_NAME=WeatherAlpha-Agent
REAL_AGENT_BADGE=ccd:agent:weather-alpha:v1
REAL_CONCORDIUM_ACCOUNT=4c9f116719b6736c92bc490453d0e34c264c8a21
REAL_AGENT_CARD_HASH=sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# 4. Cross-Chain External Key Binding (CIS-8 / Base Sepolia ERC-8004)
# Address and private key for signing requests
REAL_AGENT_CHAIN_ID=eip155:84532
REAL_AGENT_EVM_ADDRESS=0x90F8bf6A479f320ead074411a4B0e7944Ea8c9C1
REAL_AGENT_EVM_PRIVATE_KEY=

# 5. x402 Facilitator
X402_FACILITATOR_URL=https://x402.org/facilitator
